{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenID AuthZen Access Service",
    "contact": {
      "name": "OpenID Foundation - AuthZEN Working Group",
      "url": "https://openid.net/wg/authzen/"
    },
    "license": {
      "name": "Apache v2",
      "url": "https://github.com/authzen/access/blob/main/LICENSE"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "{{.Scheme}}://{{.Host}}",
      "description": "OpenID AuthZEN service"
    }
  ],
  "paths": {
    "/access/v1/evaluation": {
      "post": {
        "tags": [
          "authzen",
          "decision"
        ],
        "summary": "Access Evaluation API",
        "description": "The Access Evaluation API defines the message exchange pattern between a PEP and a PDP for executing a single access evaluation.",
        "operationId": "openid.authzen.access.v1.evaluation.post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "$ref": "#/components/schemas/authzen.access.v1.Action"
                  },
                  "context": {
                    "type": "object"
                  },
                  "resource": {
                    "$ref": "#/components/schemas/authzen.access.v1.Resource"
                  },
                  "subject": {
                    "$ref": "#/components/schemas/authzen.access.v1.Subject"
                  }
                },
                "required": [
                  "subject",
                  "action",
                  "resource"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            }
          },
          "200": {
            "description": "https://openid.github.io/authzen/#name-the-access-evaluation-api-re",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/authzen.access.v1.EvaluationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/access/v1/evaluations": {
      "post": {
        "tags": [
          "authzen",
          "decisions"
        ],
        "summary": "Access Evaluations API",
        "description": "The Access Evaluations API defines the message exchange pattern between a PEP and a PDP for evaluating multiple access evaluations within the scope of a single message exchange (also known as \"boxcarring\" requests)",
        "operationId": "openid.authzen.access.v1.evaluations.post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "$ref": "#/components/schemas/authzen.access.v1.Action"
                  },
                  "context": {
                    "type": "object"
                  },
                  "evaluations": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/authzen.access.v1.EvaluationRequest"
                    }
                  },
                  "options": {
                    "type": "object"
                  },
                  "resource": {
                    "$ref": "#/components/schemas/authzen.access.v1.Resource"
                  },
                  "subject": {
                    "$ref": "#/components/schemas/authzen.access.v1.Subject"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            }
          },
          "200": {
            "description": "https://openid.github.io/authzen/#name-access-evaluations-api-resp",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/authzen.access.v1.EvaluationsResponse"
                }
              }
            }
          }
        }
      }
    },
